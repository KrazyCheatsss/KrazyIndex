--========================================================
-- RENDER LOOP
--========================================================

RunService.RenderStepped:Connect(function()

    local Camera = workspace.CurrentCamera

    --====================================================
    -- FLY
    --====================================================

    if FlyEnabled then

        local Character = Player.Character

        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        if Root then

            local Direction = Vector3.zero

            if UIS:IsKeyDown(Enum.KeyCode.W) then
                Direction += Camera.CFrame.LookVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.S) then
                Direction -= Camera.CFrame.LookVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.A) then
                Direction -= Camera.CFrame.RightVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.D) then
                Direction += Camera.CFrame.RightVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                Direction += Vector3.yAxis
            end

            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
                Direction -= Vector3.yAxis
            end

            if Direction.Magnitude > 0 then

                Root.AssemblyLinearVelocity =
                    Direction.Unit * FlySpeed

            else

                Root.AssemblyLinearVelocity =
                    Vector3.zero
            end
        end
    end

    --====================================================
    -- FOV CIRCLE
    --====================================================

    if FOVCircle then

        local MousePosition = GetMousePosition()

        FOVCircle.Position =
            UDim2.fromOffset(
                MousePosition.X,
                MousePosition.Y
            )

        FOVCircle.Size =
            UDim2.fromOffset(
                AimlockFOV * 2,
                AimlockFOV * 2
            )

        FOVCircle.Visible =
            FOVCircleEnabled

        FOVStroke.Color =
            CurrentColor
    end

    --====================================================
    -- AIMLOCK
    --====================================================

    if AimlockEnabled and AimlockActive then

        if not AimlockTarget
            or not AimlockTarget.Parent
            or not AimlockTarget.Character then

            AimlockTarget =
                GetClosestAimlockTarget()
        end

        if AimlockTarget then

            local Character =
                AimlockTarget.Character

            local Humanoid =
                Character
                and Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local TargetPart =
                Character
                and Character:FindFirstChild(
                    AimlockPart
                )

            if Humanoid
                and Humanoid.Health > 0
                and TargetPart then

                local ScreenPosition, OnScreen =
                    Camera:WorldToViewportPoint(
                        TargetPart.Position
                    )

                if OnScreen then

                    local MousePosition =
                        GetMousePosition()

                    local Distance =
                        (
                            Vector2.new(
                                ScreenPosition.X,
                                ScreenPosition.Y
                            ) - MousePosition
                        ).Magnitude

                    if Distance <= AimlockFOV then

                        Camera.CFrame =
                            CFrame.lookAt(
                                Camera.CFrame.Position,
                                TargetPart.Position
                            )

                    else

                        AimlockTarget =
                            GetClosestAimlockTarget()
                    end

                else

                    AimlockTarget =
                        GetClosestAimlockTarget()
                end

            else

                AimlockTarget =
                    GetClosestAimlockTarget()
            end
        end
    end

    --====================================================
    -- HP BARS
    --====================================================

    for TargetPlayer, Bar in pairs(HPBars) do

        if Bar
            and Bar.Parent
            and TargetPlayer.Character then

            local Humanoid =
                TargetPlayer.Character
                :FindFirstChildOfClass(
                    "Humanoid"
                )

            local Background =
                Bar:FindFirstChildOfClass(
                    "Frame"
                )

            local Fill =
                Background
                and Background:FindFirstChild(
                    "Fill"
                )

            if Humanoid and Fill then

                Fill.Size =
                    UDim2.new(
                        1,
                        0,
                        math.clamp(
                            Humanoid.Health
                            / Humanoid.MaxHealth,
                            0,
                            1
                        ),
                        0
                    )
            end
        end
    end
end)

