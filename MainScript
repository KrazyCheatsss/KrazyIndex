MainTab:NewSection("Visuals")

local Highlights = {}
local BoxesList = {}
local HPBars = {}

local function ClearVisuals()

    for _, Object in pairs(Highlights) do
        if Object then
            Object:Destroy()
        end
    end

    for _, Object in pairs(BoxesList) do
        if Object then
            Object:Destroy()
        end
    end

    for _, Object in pairs(HPBars) do
        if Object then
            Object:Destroy()
        end
    end

    Highlights = {}
    BoxesList = {}
    HPBars = {}
end

local function AddVisual(TargetPlayer)

    if TargetPlayer == Player then
        return
    end

    local Character = TargetPlayer.Character

    if not Character then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not Root or not Humanoid then
        return
    end

    -- CHAMS
    if Chams then

        local Highlight = Instance.new("Highlight")

        Highlight.FillColor = CurrentColor
        Highlight.OutlineColor = Color3.new(1, 1, 1)

        Highlight.FillTransparency = 0.6
        Highlight.OutlineTransparency = 0

        Highlight.Adornee = Character
        Highlight.Parent = Character

        Highlights[TargetPlayer] = Highlight
    end

    -- BOX
    if Boxes then

        local Box = Instance.new("BillboardGui")

        Box.Name = "Krazy Index_Box"
        Box.Size = UDim2.new(0, 70, 0, 100)

        Box.AlwaysOnTop = true
        Box.Adornee = Root
        Box.Parent = Player:WaitForChild("PlayerGui")

        local Frame = Instance.new("Frame")

        Frame.Size = UDim2.fromScale(1, 1)
        Frame.BackgroundTransparency = 1
        Frame.Parent = Box

        local Stroke = Instance.new("UIStroke")

        Stroke.Color = CurrentColor
        Stroke.Thickness = 2
        Stroke.Parent = Frame

        BoxesList[TargetPlayer] = Box
    end

    -- HP
    if HP then

        local Bar = Instance.new("BillboardGui")

        Bar.Name = "Krazy Index_HP"
        Bar.Size = UDim2.new(0, 7, 0, 100)
        Bar.StudsOffset = Vector3.new(3.5, 0, 0)

        Bar.AlwaysOnTop = true
        Bar.Adornee = Root
        Bar.Parent = Player:WaitForChild("PlayerGui")

        local Background = Instance.new("Frame")

        Background.Size = UDim2.fromScale(1, 1)
        Background.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        Background.BorderSizePixel = 0
        Background.Parent = Bar

        local Fill = Instance.new("Frame")

        Fill.Name = "Fill"
        Fill.AnchorPoint = Vector2.new(0, 1)
        Fill.Position = UDim2.new(0, 0, 1, 0)

        Fill.Size = UDim2.new(1, 0, 1, 0)
        Fill.BackgroundColor3 = Color3.fromRGB(40, 220, 80)
        Fill.BorderSizePixel = 0

        Fill.Parent = Background

        HPBars[TargetPlayer] = Bar
    end
end

local function UpdateVisuals()

    ClearVisuals()

    for _, TargetPlayer in ipairs(Players:GetPlayers()) do
        AddVisual(TargetPlayer)
    end
end

MainTab:NewToggle("Chams / Highlights Everyone", false, function(value)
