--========================================================
-- AIMLOCK TARGET FINDER
--========================================================

local function GetMousePosition()
    local MouseLocation = UIS:GetMouseLocation()

    return Vector2.new(
        MouseLocation.X,
        MouseLocation.Y
    )
end

local function GetClosestAimlockTarget()
    local Camera = workspace.CurrentCamera
    local MousePosition = GetMousePosition()

    local ClosestPlayer = nil
    local ClosestDistance = AimlockFOV

    for _, TargetPlayer in ipairs(Players:GetPlayers()) do
        if TargetPlayer ~= Player then

            local Character = TargetPlayer.Character
            local Humanoid = Character
                and Character:FindFirstChildOfClass("Humanoid")

            local TargetPart = Character
                and Character:FindFirstChild(AimlockPart)

            if Humanoid
                and Humanoid.Health > 0
                and TargetPart then

                local ScreenPosition, OnScreen =
                    Camera:WorldToViewportPoint(TargetPart.Position)

                if OnScreen then

                    local Distance = (
                        Vector2.new(
                            ScreenPosition.X,
                            ScreenPosition.Y
                        ) - MousePosition
                    ).Magnitude

                    if Distance <= ClosestDistance then
                        ClosestDistance = Distance
                        ClosestPlayer = TargetPlayer
                    end
                end
            end
        end
    end

    return ClosestPlayer
end

--========================================================
-- AIMLOCK INPUT - Q TOGGLE
--========================================================

UIS.InputBegan:Connect(function(Input, Processed)
    if Processed then
        return
    end

    if Input.KeyCode == Enum.KeyCode.Q
        and AimlockEnabled then

        -- Q again = unlock
        if AimlockActive then
            AimlockActive = false
            AimlockTarget = nil

            Notify("Aimlock Unlocked", 2)
            return
        end

        -- First Q = lock onto closest player in FOV
        local Target = GetClosestAimlockTarget()

        if Target then
            AimlockTarget = Target
            AimlockActive = true

            Notify(
                "Locked: " .. Target.Name,
                2,
                "success"
            )
        else
            Notify(
                "No player in FOV.",
                2,
                "error"
            )
        end
    end
end)

