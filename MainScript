local SettingsTab = library:NewTab("Settings")

local function RecolorGUI(OldColor, NewColor)

    local GuiParents = {}

    pcall(function()
        table.insert(
            GuiParents,
            game:GetService("CoreGui")
        )
    end)

    table.insert(
        GuiParents,
        Player:WaitForChild("PlayerGui")
    )

    for _, GuiParent in ipairs(GuiParents) do

        for _, Object in ipairs(
            GuiParent:GetDescendants()
        ) do

            pcall(function()

                if Object:IsA("TextLabel")
                    or Object:IsA("TextButton")
                    or Object:IsA("TextBox") then

                    if Object.TextColor3 == OldColor then
                        Object.TextColor3 = NewColor
                    end
                end

                if Object:IsA("Frame")
                    or Object:IsA("TextButton")
                    or Object:IsA("TextBox") then

                    if Object.BackgroundColor3 == OldColor then
                        Object.BackgroundColor3 = NewColor
                    end
                end

                if Object:IsA("UIStroke") then

                    if Object.Color == OldColor then
                        Object.Color = NewColor
                    end
                end

                if Object:IsA("ScrollingFrame") then

                    if Object.ScrollBarImageColor3 == OldColor then
                        Object.ScrollBarImageColor3 = NewColor
                    end
                end

            end)
        end
    end
end

local function SetColor(Color)

    local OldColor = CurrentColor

    CurrentColor = Color

    library.headerColor = Color
    library.companyColor = Color
    library.acientColor = Color

    RecolorGUI(
        OldColor,
        Color
    )

    FOVStroke.Color = Color

    UpdateVisuals()
end

